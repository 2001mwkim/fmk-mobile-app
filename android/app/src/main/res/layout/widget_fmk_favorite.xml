<?xml version="1.0" encoding="utf-8"?>
<!-- 최애 드라이버 위젯(미니멀 스탯): 킥커 + '최애 드라이버' + 이름/순위/포인트/변동.
     데이터 키(favDriver*)는 lib/services/fmk_home_widget_bridge.dart 의
     _saveFavoriteDriverPayload 와 수동 동기화 — 한쪽을 바꾸면 함께 수정할 것.
     기본 텍스트는 샘플(미리보기용) — Provider 가 런타임에 덮어쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_favorite"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.22"
        android:maxLines="1"
        android:text="VIA FORMULA"
        android:textColor="@color/fmk_faint"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="최애 드라이버"
        android:textColor="@color/fmk_white"
        android:textSize="15sp" />

    <!-- 콘텐츠(최애 설정됨) -->
    <LinearLayout
        android:id="@+id/grp_fav_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_fav_bar"
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/accent_bar" />

            <TextView
                android:id="@+id/tv_fav_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="르클레르"
                android:textColor="@color/fmk_white"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_fav_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="P4"
                android:textColor="@color/fmk_red"
                android:textSize="24sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/tv_fav_pts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="138 PTS"
                android:textColor="@color/fmk_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fav_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/fmk_dim"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 빈 상태(최애 미설정) -->
    <TextView
        android:id="@+id/tv_fav_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="탭해서 최애 드라이버를\n설정하세요"
        android:textColor="@color/fmk_dim"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
