<?xml version="1.0" encoding="utf-8"?>
<!-- 일정 위젯 피커 미리보기(런처가 데이터 없이 inflate 하므로 샘플 하드코딩).
     미리보기는 항상 다크 기준으로 보이도록 배경·글자색을 하드코딩한다(@color 는
     라이트 폰에서 흰 배경으로 해석돼 미리보기가 하얗게 나온다). 토글 없음. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/accent_bar"
                android:scaleType="fitXY"
                android:tint="#EF4444"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:text="🇦🇺"
                android:textColor="#FAFAFA"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="호주 그랑프리"
                android:textColor="#FAFAFA"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="KST"
                android:textColor="#71717A"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="5dp"
            android:background="#14FFFFFF"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 지난 세션(ghost) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="8dp" android:background="@drawable/dot_red" android:visibility="invisible" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:text="연습 1" android:textColor="#52525B" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:text="3.13 금" android:textColor="#52525B" android:textSize="11sp" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:gravity="end" android:includeFontPadding="false" android:text="10:30" android:textColor="#52525B" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="8dp" android:background="@drawable/dot_red" android:visibility="invisible" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:text="연습 2" android:textColor="#52525B" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:text="3.13 금" android:textColor="#52525B" android:textSize="11sp" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:gravity="end" android:includeFontPadding="false" android:text="14:00" android:textColor="#52525B" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="8dp" android:background="@drawable/dot_red" android:visibility="invisible" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:text="연습 3" android:textColor="#52525B" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:text="3.14 토" android:textColor="#52525B" android:textSize="11sp" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:gravity="end" android:includeFontPadding="false" android:text="10:30" android:textColor="#52525B" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- 다음 세션(레드 도트 + 레드 시간) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="8dp" android:background="@drawable/dot_red" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:text="퀄리파잉" android:textColor="#FAFAFA" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:text="3.14 토" android:textColor="#A1A1AA" android:textSize="11sp" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:gravity="end" android:includeFontPadding="false" android:text="14:00" android:textColor="#EF4444" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="8dp" android:background="@drawable/dot_red" android:visibility="invisible" android:contentDescription="@null" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:text="레이스" android:textColor="#D4D4D8" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:text="3.15 일" android:textColor="#A1A1AA" android:textSize="11sp" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:gravity="end" android:includeFontPadding="false" android:text="13:00" android:textColor="#FAFAFA" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
