<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_my_team"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/iv_myTeam_glow"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-82dp"
        android:layout_marginEnd="-54dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_glow" />

    <LinearLayout
        android:id="@+id/grp_myTeam_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_myTeam_kicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:text="MY TEAM"
                android:textColor="@color/fmk_red"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_myTeam_bar"
                    android:layout_width="4dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/accent_bar" />
                <TextView
                    android:id="@+id/tv_myTeam_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.025"
                    android:maxLines="2"
                    android:text="MERCEDES"
                    android:textColor="@color/fmk_white"
                    android:textSize="27sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_myTeam_name"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_myTeam_sub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom|start"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_myTeam_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="P1"
                    android:textColor="@color/fmk_white"
                    android:textSize="27sp" />
                <TextView
                    android:id="@+id/tv_myTeam_pts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="379"
                    android:textColor="@color/fmk_white"
                    android:textSize="22sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="PTS"
                    android:textColor="@color/fmk_dim"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tv_myTeam_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:textColor="@color/fmk_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="126dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/card_myTeam_driver1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="11dp">
                <TextView
                    android:id="@+id/tv_myTeam_d1_pos"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="P1"
                    android:textColor="@color/fmk_dim"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tv_myTeam_d1_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="ANT"
                    android:textColor="@color/fmk_white"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/tv_myTeam_d1_pts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="219"
                    android:textColor="@color/fmk_white"
                    android:textSize="16sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="6dp" />
            <LinearLayout
                android:id="@+id/card_myTeam_driver2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="11dp">
                <TextView
                    android:id="@+id/tv_myTeam_d2_pos"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="P3"
                    android:textColor="@color/fmk_dim"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tv_myTeam_d2_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="RUS"
                    android:textColor="@color/fmk_white"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/tv_myTeam_d2_pts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="160"
                    android:textColor="@color/fmk_white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grp_myTeam_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_myTeam_empty_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:text="MY TEAM"
            android:textColor="@color/fmk_dim"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/tv_myTeam_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="MY PICKS에서 최애 팀을 설정해 주세요"
            android:textColor="@color/fmk_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
