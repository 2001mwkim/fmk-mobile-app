<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱 ↔ 위젯 데이터 공유. 문자열은 fmk_home_widget_bridge.dart 의
	     fmkWidgetAppGroupId, FmkWidgets.entitlements 와 수동 동기화. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.kr.formulamagazine.fmk</string>
	</array>
	<!-- Live Activity 푸시 토큰(pushType .token) 요구 사항.
	     스토어 배포 프로비저닝이 production 으로 자동 치환한다. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
