	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>PHM7ANUX4X</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>kr.formulamagazine.fmk</key>
		<string>fmk appstore</string>
		<key>kr.formulamagazine.fmk.FmkWidgets</key>
		<string>fmk widgets appstore</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
